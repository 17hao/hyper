{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "yarn dev",
      "type": "shell",
      "command": "yarn dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "applyTo": "closedDocuments",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+,\\d+)\\):\\s*(error|warning|info)\\s*(TS\\d+)?\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting compilation|File change detected",
          "endsPattern": "Found 0 errors\\.\\s*Watching for file changes\\.|compiled successfully"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "group": "hyper",
        "clear": false
      },
      "runOptions": {
        "runOn": "default"
      }
    },
    {
      "label": "yarn app",
      "type": "shell",
      "command": "yarn app",
      "dependsOn": ["yarn dev"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "appName:|electron will open|running in"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "group": "hyper",
        "clear": false
      }
    }
  ]
}
